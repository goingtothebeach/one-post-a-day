# 后端环境变量模板。复制为 server/.env 后填入真实值。
# 注意：server/.env 不要提交进 git（.gitignore 已忽略）。

# --- 数据库 ---
DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# --- 鉴权 ---
# 生产环境务必换成足够长的随机串，例如 `openssl rand -hex 32`
JWT_SECRET=

# 定时抽签鉴权。必须配置，否则 POST /lottery/run 会直接返回 503
# （fail-closed，避免任何人裸调重抽赢家）。
# 需与 GitHub Actions Secrets 里的 CRON_SECRET 一致。
CRON_SECRET=

# --- CORS ---
# 逗号分隔的允许来源。不配则用代码里的默认值（线上域名 + 本地开发端口）。
CORS_ORIGINS=https://onedayapost.fun,http://localhost:8081,http://localhost:19006

# --- 阿里云 OSS（图片上传）---
# RAM 用户的 AK/SK（不要用主账号密钥）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# RAM 角色 ARN，格式 acs:ram::<账号ID>:role/<角色名>
# 注意变量名是 ALIYUN_OSS_ROLE_ARN（不是 STS），代码读的是这个
ALIYUN_OSS_ROLE_ARN=
# 必填，无默认值。OSS bucket 名全局唯一，旧的 one-post-a-day 已被他人占用，
# 必须换新名字（例如 onedayapost-media）
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_STS_DURATION=3600

# --- 阿里云「号码认证服务」PNVS（登录验证码）---
# 注意：调的是 dypnsapi.aliyuncs.com 的 SendSmsVerifyCode，
# 属于【号码认证服务】而非普通【短信服务】，需在控制台开启「融合认证」，
# 否则报 FUNCTION_NOT_OPENED。运营商已收紧自定义签名，建议用系统赠送签名+赠送模板
# （两者必须配套使用）。模板变量需含 code 与 min。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 可选，业务场景方案名。不填走「默认方案」
ALIYUN_SMS_SCHEME=

# 本地开发用：设为 1 时验证码固定为 123456 且不真发短信。生产必须为 0。
DEV_FAKE_OTP=0
